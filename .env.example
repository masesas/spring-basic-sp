# Salin berkas ini menjadi .env lalu isi nilainya.
#
#   cp .env.example .env
#
# .env TIDAK ikut di-commit (lihat .gitignore). Berkas inilah yang di-commit,
# sebagai daftar variabel apa saja yang dibutuhkan aplikasi untuk hidup.
#
# Dibaca lewat spring.config.import di application.properties, jadi formatnya
# mengikuti aturan file .properties: tanpa awalan `export`, tanpa tanda kutip
# (tanda kutip akan ikut terbaca sebagai bagian dari nilai).

# ===== Database =====
DB_URL=jdbc:postgresql://host:5432/nama_database
DB_USERNAME=isi_username
DB_PASSWORD=isi_password
DB_SCHEMA=isi_schema

# ===== Redis =====
REDIS_HOST=host
REDIS_PORT=6379
REDIS_USERNAME=isi_username
REDIS_PASSWORD=isi_password

# ===== JWT (A07) =====
# Minimal 32 karakter — HS256 menolak kunci yang lebih pendek.
# Buat nilai acak: openssl rand -base64 48
JWT_SECRET=isi_dengan_nilai_acak_minimal_32_karakter

# ===== Enkripsi NIK/NPWP (A02) =====
# Kunci AES-256 dalam Base64, tepat 32 byte sebelum di-encode.
# Buat nilai acak: openssl rand -base64 32
#
# PERINGATAN: kunci ini satu-satunya cara membaca kembali NIK dan NPWP yang
# sudah terenkripsi. Menggantinya membuat data lama tidak terbaca selamanya.
CRYPTO_KEY=isi_dengan_kunci_aes_256_base64

# ===== Akun demo =====
DEMO_PASSWORD=isi_password_akun_demo

# ===== Profile local =====
# Dibaca application-local.properties, yang aktif saat `./mvnw test` dan
# `./mvnw spring-boot:run` (diaktifkan di pom.xml).
APP_SERVER_PORT=8080
# Wajib berbeda dari demo:dev dan demo:prod — Redis-nya sama, dan tanpa prefix
# sendiri pengembangan lokal akan menimpa cache container yang sedang jalan.
APP_REDIS_KEY_PREFIX=demo:lokal

# Tiga di bawah ini opsional; application-local.properties sudah punya nilai
# bawaan yang masuk akal untuk mesin pengembang. Isi hanya kalau perlu berbeda.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# APP_IMAGE_BASE_DIR=./resources/images
# DUMMYJSON_BASE_URL=https://dummyjson.com
