### ===========================================================================
### TANPA PERAN  —  tanparole@masesas.test (karyawan id 6)
###
### Akun ini punya email dan password, tetapi tidak punya satu pun baris di
### masesas.karyawan_role. Gunanya memisahkan dua hal yang sering tertukar:
###
###   autentikasi berhasil  -> login 200, token terbit
###   otorisasi gagal       -> setiap endpoint ber-@PreAuthorize membalas 403
###
### Bukan 401. Token-nya sah; yang kurang adalah perannya.
###
### Berkas ini juga memperlihatkan sisi lain yang patut ditinjau: endpoint
### tanpa @PreAuthorize tetap terbuka untuk akun tanpa peran sama sekali,
### karena SecurityConfig hanya menuntut anyRequest().authenticated().
### ===========================================================================


### 1. Login — 200, tetapi daftar peran kosong
POST {{baseUrl}}/api/auth/karyawan/login
Content-Type: application/json

{
  "username": "{{emailTanpaPeran}}",
  "password": "{{demoPassword}}"
}

> {%
    client.test("login berhasil", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
    client.test("daftar peran kosong", function () {
        client.assert(response.body.roles.length === 0, "roles = " + response.body.roles);
    });
    client.global.set("token", response.body.token);

    const sekarang = new Date();
    const periode = sekarang.getFullYear() + "-"
        + String(sekarang.getMonth() + 1).padStart(2, "0") + "-01";
    client.global.set("periode", periode);
%}


### ---------------------------------------------------------------------------
### 2. Tetap bisa diakses — endpoint tanpa @PreAuthorize
### ---------------------------------------------------------------------------

### 2.1 GET /api/karyawan2 — 200
GET {{baseUrl}}/api/karyawan2
Authorization: Bearer {{token}}

> {% client.test("200", function () { client.assert(response.status === 200, "status " + response.status); }); %}

### 2.2 GET /api/karyawan2/{id} — 200
GET {{baseUrl}}/api/karyawan2/{{idTanpaPeran}}
Authorization: Bearer {{token}}

> {% client.test("200", function () { client.assert(response.status === 200, "status " + response.status); }); %}

### 2.3 GET /api/sp/karyawan/{id} — lolos otorisasi (butuh stored procedure terpasang)
GET {{baseUrl}}/api/sp/karyawan/{{idTanpaPeran}}
Authorization: Bearer {{token}}

> {%
    client.test("bukan 401/403", function () {
        client.assert(response.status !== 401 && response.status !== 403, "status " + response.status);
    });
%}

### 2.4 GET /api/sp/karyawan/statistik/total — lolos otorisasi (butuh stored procedure terpasang)
GET {{baseUrl}}/api/sp/karyawan/statistik/total?status=AKTIF
Authorization: Bearer {{token}}

> {%
    client.test("bukan 401/403", function () {
        client.assert(response.status !== 401 && response.status !== 403, "status " + response.status);
    });
%}

### ---------------------------------------------------------------------------
### 3. Semua endpoint ber-@PreAuthorize membalas 403
### ---------------------------------------------------------------------------

### 3.1 GET /api/karyawan — 403
GET {{baseUrl}}/api/karyawan?page=0&size=5
Authorization: Bearer {{token}}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

### 3.2 GET /api/karyawan/{id} — 403
GET {{baseUrl}}/api/karyawan/{{idTanpaPeran}}
Authorization: Bearer {{token}}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

### 3.3 GET /api/karyawan/all — 403
GET {{baseUrl}}/api/karyawan/all
Authorization: Bearer {{token}}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

### 3.4 POST /api/karyawan — 403
POST {{baseUrl}}/api/karyawan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Uji RBAC Tanpa Peran",
  "alamat": "Jalan Uji 1",
  "dob": "1990-01-01",
  "status": "AKTIF"
}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

### 3.5 PUT /api/karyawan/{id} — 403
PUT {{baseUrl}}/api/karyawan/{{idTanpaPeran}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Uji RBAC Tanpa Peran",
  "alamat": "Jalan Uji 2",
  "dob": "1990-01-01",
  "status": "AKTIF"
}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

### 3.6 DELETE /api/karyawan/{id} — 403
DELETE {{baseUrl}}/api/karyawan/{{idTanpaPeran}}
Authorization: Bearer {{token}}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

