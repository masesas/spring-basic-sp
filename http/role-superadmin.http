### ---------------------------------------------------------------------------
### 5. Peta akses yang dihasilkan aplikasi
### ---------------------------------------------------------------------------

### 5.1 GET /api/rolemap/SUPERADMIN — publik, tanpa token
###
### Bahwa jumlahnya sama dengan jumlah SELURUH endpoint terdaftar diperiksa di
### RbacSuperadminTest.rolemapSuperadminMemuatSeluruhEndpoint — perbandingan
### dua respons seperti itu di luar jangkauan runner.py.
GET {{baseUrl}}/api/rolemap/SUPERADMIN

> {%
    client.test("200", function () { client.assert(response.status === 200, "status " + response.status); });
    client.test("peran SUPERADMIN", function () {
        client.assert(response.body.data.peran === "SUPERADMIN", "peran " + response.body.data.peran);
    });
    client.test("jumlah cocok dengan panjang daftar", function () {
        client.assert(response.body.data.jumlah === response.body.data.endpoint.length,
            "jumlah " + response.body.data.jumlah + " vs " + response.body.data.endpoint.length);
    });
%}

