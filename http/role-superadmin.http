### ===========================================================================
### ROLE: SUPERADMIN  —  superadmin@masesas.test (karyawan id 9)
###
### Satu-satunya peran tanpa penolakan. SUPERADMIN tidak disebut di satu pun
### @PreAuthorize; haknya datang dari RoleHierarchy di SecurityConfig, yang
### membuat ROLE_SUPERADMIN mengimplikasikan ADMIN, MANAGER, MARKETING, SALES,
### HR, KARYAWAN, dan CUSTOMER sekaligus.
###
### Yang paling mudah tertukar ada di bagian 4: /api/customer/me dibalas 404,
### bukan 403. Otorisasinya lolos — yang tidak ada hanyalah baris customer
### dengan email ini. Itulah bedanya "tidak berhak" dengan "tidak ada datanya".
###
### Berkas ini membuat datanya sendiri lalu menghapusnya kembali di bagian
### terakhir, jadi aman dijalankan berulang kali.
### ===========================================================================


### 1. Login
POST {{baseUrl}}/api/auth/karyawan/login
Content-Type: application/json

{
  "username": "{{emailSuperadmin}}",
  "password": "{{demoPassword}}"
}

> {%
    client.test("login berhasil", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
    client.test("peran SUPERADMIN datang dari database", function () {
        client.assert(response.body.data.roles.includes("SUPERADMIN"), "roles = " + response.body.data.roles);
    });
    client.test("peran turunan tidak ikut di token — hanya SUPERADMIN", function () {
        client.assert(response.body.data.roles.length === 1, "roles = " + response.body.data.roles);
    });
    client.global.set("token", response.body.data.token);

    const sekarang = new Date();
    const periode = sekarang.getFullYear() + "-"
        + String(sekarang.getMonth() + 1).padStart(2, "0") + "-01";
    client.global.set("periode", periode);
%}


