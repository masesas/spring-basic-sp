### 4.1 POST /api/karyawan — 403 (hanya ADMIN & MANAGER)
POST {{baseUrl}}/api/karyawan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Uji RBAC HR",
  "alamat": "Jalan Uji 1",
  "dob": "1990-01-01",
  "status": "AKTIF"
}

> {% client.test("403", function () { client.assert(response.status === 403, "status " + response.status); }); %}

