### 3.5 POST /api/payroll — 201
POST {{baseUrl}}/api/payroll
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idKaryawan": {{idTanpaPeran}},
  "periode": "{{periode}}",
  "gajiPokok": 6000000,
  "tunjangan": 500000,
  "potongan": 250000
}

> {%
    client.test("201", function () { client.assert(response.status === 201, "status " + response.status); });
    client.global.set("versiPayroll", response.body.data.version);
%}

