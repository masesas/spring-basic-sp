### ===========================================================================
### ROLE: HR  —  hr@masesas.test (karyawan id 7)
###
### HR adalah peran payroll penuh, tetapi BUKAN peran administrasi karyawan:
###   * seluruh /api/payroll termasuk DELETE   -> boleh
###   * membaca /api/karyawan                  -> boleh
###   * membuat/mengubah/menghapus karyawan    -> 403
###
### Payroll dibuat di atas karyawan yang sudah ada (id 6), karena HR tidak
### punya hak membuat karyawan baru. Bagian 3.1 menghapus sisa run sebelumnya
### supaya berkas ini aman dijalankan berulang kali.
### ===========================================================================


### 1. Login
POST {{baseUrl}}/api/auth/karyawan/login
Content-Type: application/json

{
  "username": "{{emailHr}}",
  "password": "{{demoPassword}}"
}

> {%
    client.test("login berhasil", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
    client.test("peran HR datang dari database", function () {
        client.assert(response.body.data.roles.includes("HR"), "roles = " + response.body.data.roles);
    });
    client.global.set("token", response.body.data.token);

    const sekarang = new Date();
    const periode = sekarang.getFullYear() + "-"
        + String(sekarang.getMonth() + 1).padStart(2, "0") + "-01";
    client.global.set("periode", periode);
%}


### ---------------------------------------------------------------------------
### 2. Tier "cukup login" — endpoint tanpa @PreAuthorize
### ---------------------------------------------------------------------------

### 2.1 GET /api/karyawan2 — 200
GET {{baseUrl}}/api/karyawan2
Authorization: Bearer {{token}}

> {% client.test("200", function () { client.assert(response.status === 200, "status " + response.status); }); %}

### 2.2 GET /api/sp/karyawan/statistik/total — lolos otorisasi (butuh stored procedure terpasang)
GET {{baseUrl}}/api/sp/karyawan/statistik/total?status=AKTIF
Authorization: Bearer {{token}}

> {%
    client.test("bukan 401/403", function () {
        client.assert(response.status !== 401 && response.status !== 403, "status " + response.status);
    });
%}

### ---------------------------------------------------------------------------
### 3. Akses yang DIIZINKAN untuk HR
### ---------------------------------------------------------------------------

### 3.1 Sisa run sebelumnya — 204 bila ada, 404 bila tidak ada
DELETE {{baseUrl}}/api/payroll/{{idTanpaPeran}}/{{periode}}
Authorization: Bearer {{token}}

> {%
    client.test("204 atau 404", function () {
        client.assert(response.status === 204 || response.status === 404, "status " + response.status);
    });
%}

