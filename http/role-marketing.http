### ===========================================================================
### ROLE: MARKETING  —  marketing@masesas.test (karyawan id 3)
###
### Peran baca-saja atas data karyawan. Ikut di @PreAuthorize kelas
### KaryawanController, tetapi tidak di satu pun @PreAuthorize method yang
### mengubah data, dan tidak di PayrollController sama sekali.
###
### Berkas ini tidak membuat maupun mengubah data apa pun.
### ===========================================================================


### 1. Login
POST {{baseUrl}}/api/auth/karyawan/login
Content-Type: application/json

{
  "username": "{{emailMarketing}}",
  "password": "{{demoPassword}}"
}

> {%
    client.test("login berhasil", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
    client.test("peran MARKETING datang dari database", function () {
        client.assert(response.body.data.roles.includes("MARKETING"), "roles = " + response.body.data.roles);
    });
    client.global.set("token", response.body.data.token);

    const sekarang = new Date();
    const periode = sekarang.getFullYear() + "-"
        + String(sekarang.getMonth() + 1).padStart(2, "0") + "-01";
    client.global.set("periode", periode);
%}


### ---------------------------------------------------------------------------
### 2. Tier "cukup login" — endpoint tanpa @PreAuthorize
### ---------------------------------------------------------------------------

### 2.1 GET /api/karyawan2 — 200
GET {{baseUrl}}/api/karyawan2
Authorization: Bearer {{token}}

> {% client.test("200", function () { client.assert(response.status === 200, "status " + response.status); }); %}

### 2.2 GET /api/karyawan2/{id} — 200
GET {{baseUrl}}/api/karyawan2/{{idMarketing}}
Authorization: Bearer {{token}}

> {% client.test("200", function () { client.assert(response.status === 200, "status " + response.status); }); %}

### 2.3 GET /api/sp/karyawan/statistik/total — lolos otorisasi (butuh stored procedure terpasang)
GET {{baseUrl}}/api/sp/karyawan/statistik/total?status=AKTIF
Authorization: Bearer {{token}}

> {%
    client.test("bukan 401/403", function () {
        client.assert(response.status !== 401 && response.status !== 403, "status " + response.status);
    });
%}

