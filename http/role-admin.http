### 3.8b POST /api/karyawan/{id}/avatar — 200, unggah gambar avatar
POST {{baseUrl}}/api/karyawan/{{idBaru}}/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=BatasBerkas

--BatasBerkas
Content-Disposition: form-data; name="file"; filename="avatar-contoh.png"
Content-Type: image/png

< ./avatar-contoh.png
--BatasBerkas--

> {%
    client.test("200", function () { client.assert(response.status === 200, "status " + response.status); });
    client.test("avatar terisi", function () { client.assert(response.body.data.avatar !== null, "avatar kosong"); });
%}

