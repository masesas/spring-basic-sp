### 3.6 POST /api/karyawan — 201 (hanya ADMIN & MANAGER)
POST {{baseUrl}}/api/karyawan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Uji RBAC Admin",
  "alamat": "Jalan Uji 1",
  "dob": "1990-01-01",
  "status": "AKTIF"
}

> {%
    client.test("201", function () { client.assert(response.status === 201, "status " + response.status); });
    client.global.set("idBaru", response.body.data.id);
%}

### 3.7 PUT /api/karyawan/{id} — 200 (hanya ADMIN & MANAGER)
PUT {{baseUrl}}/api/karyawan/{{idBaru}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Uji RBAC Admin Diubah",
  "alamat": "Jalan Uji 2",
  "dob": "1990-01-01",
  "status": "AKTIF"
}

> {% client.test("200", function () { client.assert(response.status === 200, "status " + response.status); }); %}

