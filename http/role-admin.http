### 3.10 POST /api/payroll — 201 (ADMIN, MANAGER, HR)
POST {{baseUrl}}/api/payroll
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idKaryawan": {{idBaru}},
  "periode": "{{periode}}",
  "gajiPokok": 8000000,
  "tunjangan": 1000000,
  "potongan": 500000
}

> {%
    client.test("201", function () { client.assert(response.status === 201, "status " + response.status); });
    client.global.set("versiPayroll", response.body.data.version);
%}

