<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.masesas.exercises</groupId>
    <artifactId>demo1</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>demo1</name>
    <description>demo1</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>3.1.0</springdoc.version>
        <bucket4j.version>8.14.0</bucket4j.version>
        <dependency-check.version>12.1.0</dependency-check.version>
        <enforcer.version>3.5.0</enforcer.version>
        <jacoco.version>0.8.13</jacoco.version>
        <!-- Ambang kegagalan build. 7.0 = batas bawah severity HIGH menurut CVSS v3. -->
        <dependency-check.failOnCVSS>7</dependency-check.failOnCVSS>
        <!-- Ambang minimum cakupan test yang diperiksa jacoco:check pada fase verify. -->
        <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
        <!-- Kosong = tanpa API key, pemindaian jauh lebih lambat. Timpa lewat -Dnvd.api.key=... -->
        <nvd.api.key></nvd.api.key>

        <!--
            Menimpa versi bawaan spring-boot-dependencies:4.1.0 karena pemindaian A06
            menemukan CVE dengan CVSS >= 7 pada ketiganya. Spring Boot 4.1.0 sendiri
            sudah versi terbaru, jadi tidak bisa diperbaiki dengan menaikkan parent.

            Hapus baris-baris ini ketika parent sudah membawa versi yang sama atau
            lebih baru — kalau tidak, justru bisa menahan proyek di versi lama.
        -->
        <netty.version>4.2.17.Final</netty.version>
        <tomcat.version>11.0.24</tomcat.version>
        <postgresql.version>42.7.13</postgresql.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            Dokumentasi API. Starter ini membawa generator spesifikasi springdoc
            plus UI Scalar, dan sengaja tidak membawa webjar swagger-ui.

            Versi ditulis eksplisit karena springdoc tidak dikelola parent
            spring-boot-dependencies, sementara maven-enforcer di bawah
            melarang versi dinamis.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Versi JUnit, Mockito, dan AssertJ tidak ditulis: sudah dikelola
            spring-boot-dependencies lewat parent. Menulis versi sendiri justru
            berisiko bentrok dengan versi yang dipakai starter test bawaan.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        application.properties tidak lagi memuat konfigurasi
                        database maupun Redis, jadi tidak ada skenario yang
                        boleh berjalan tanpa profile. `mvn spring-boot:run`
                        memakai profile local, yang membaca .env.
                    -->
                    <profiles>
                        <profile>local</profile>
                    </profiles>
                </configuration>
            </plugin>

            <!--
                Alasan yang sama untuk test: profile local diaktifkan di sini,
                bukan lewat @ActiveProfiles di tiap kelas test. Satu tempat,
                berlaku untuk `mvn test` di mesin pengembang maupun di CI.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>local</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                OWASP A06 — Vulnerable and Outdated Components.

                Memindai seluruh dependency terhadap basis data NVD dan menggagalkan
                build bila ada kerentanan dengan skor CVSS >= 7 (severity HIGH).

                Terikat ke fase verify, jadi ikut berjalan pada `mvn verify` dan
                `mvn install`, tapi tidak memperlambat `mvn test` sehari-hari.

                Pemindaian pertama mengunduh basis data NVD dan bisa memakan
                waktu lama. Jauh lebih cepat dengan API key gratis dari
                https://nvd.nist.gov/developers/request-an-api-key :

                    mvn verify -Dnvd.api.key=ISI_API_KEY_ANDA
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <failBuildOnCVSS>${dependency-check.failOnCVSS}</failBuildOnCVSS>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- Analyzer untuk ekosistem lain hanya memperlambat, tidak dipakai di sini. -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <!--
                        OSS Index dimatikan: layanannya membalas 401 untuk akses anonim,
                        sehingga build gagal karena alasan jaringan, bukan karena temuan
                        keamanan. Build yang gagal karena sebab di luar kendali kita
                        melatih orang untuk mengabaikan kegagalannya.

                        NVD tetap sumber utama dan tidak terpengaruh. Untuk menyalakan
                        kembali, sediakan kredensial lewat ossIndexUsername dan
                        ossIndexPassword lalu ubah nilai ini jadi true.
                    -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <nuspecAnalyzerEnabled>false</nuspecAnalyzerEnabled>
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                    <suppressionFiles>
                        <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
                <executions>
                    <execution>
                        <id>owasp-a06-scan</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Menjaga agar build bisa diulang. Versi dinamis (1.2.+, LATEST, RELEASE)
                dan dependency SNAPSHOT membuat isi build berubah tanpa ada perubahan
                kode — hasil pemindaian kerentanan pun jadi tidak ada artinya.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.version}</version>
                <executions>
                    <execution>
                        <id>owasp-a06-aturan-dependency</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <banDynamicVersions/>
                                <requireReleaseDeps>
                                    <message>Dependency SNAPSHOT tidak boleh dipakai.</message>
                                </requireReleaseDeps>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Cakupan test. `mvn test` menghasilkan target/site/jacoco/index.html,
                `mvn verify` juga memeriksa ambang minimum dan gagal bila kurang.

                Yang dikecualikan hanya kode tanpa cabang logika: entity, DTO,
                konfigurasi Spring, dan kelas main. Mengukurnya cuma menaikkan
                angka tanpa menambah keyakinan apa pun terhadap perilaku aplikasi.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/masesas/exercises/demo1/Demo1Application.class</exclude>
                        <exclude>com/masesas/exercises/demo1/config/**</exclude>
                        <exclude>com/masesas/exercises/demo1/dto/**</exclude>
                        <exclude>com/masesas/exercises/demo1/entity/**</exclude>
                        <exclude>com/masesas/exercises/demo1/model/**</exclude>
                        <exclude>com/masesas/exercises/demo1/projection/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-pasang-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-laporan</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-ambang-minimum</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.masesas.exercises.demo1.service.impl.KaryawanServiceImpl</include>
                                        <include>com.masesas.exercises.demo1.controller.KaryawanController</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
